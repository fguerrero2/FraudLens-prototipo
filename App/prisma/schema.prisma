generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Transaction {
  tenantId String @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id])
  latitude Float?
  longitude Float?
  modelVersion String?
  id String @id @default(uuid())

  // Identificador de negocio enviado por el sistema cliente (transaction_id).
  externalId String

  userId    String
  timestamp DateTime
  receivedAt DateTime @default(now())
  amount    Decimal @db.Decimal(18, 2)
  currency  String
  category  String
  merchant  String
  country   String
  channel   String
  deviceId  String?

  // Campos estilo PaySim (dataset de referencia: Synthetic Financial Datasets
  // For Fraud Detection), opcionales: se usan como senales extra del motor de
  // riesgo cuando el sistema cliente los provee (transferencias, billeteras).
  operationType   String? // CASH_IN | CASH_OUT | DEBIT | PAYMENT | TRANSFER
  nameOrig        String?
  oldBalanceOrig  Decimal? @db.Decimal(18, 2)
  newBalanceOrig  Decimal? @db.Decimal(18, 2)
  nameDest        String?
  oldBalanceDest  Decimal? @db.Decimal(18, 2)
  newBalanceDest  Decimal? @db.Decimal(18, 2)

  // Resultado del analisis
  riskScore       Float?
  riskLevel       String? // bajo | medio | alto | critico | no_evaluado
  decision        String // aprobar | revisar | bloquear
  analyzedByModel Boolean
  status          String // analizada | no_evaluada | analisis_no_disponible
  ruleApplied     String

  // Trazabilidad (CU-06 / NFR): factores completos del modelo, resumen del
  // historial utilizado y snapshot de los umbrales vigentes al momento del analisis.
  factors           String // JSON: [{ code, label, points }]
  historySummary    String? // JSON
  thresholdSnapshot String // JSON

  reviews TransactionReview[]
  fraudCase FraudCase?
  auditLogs AuditLog[]
  alerts Alert[]

  createdAt DateTime @default(now())

  @@unique([tenantId, externalId])
  @@unique([id, tenantId])
  @@index([tenantId, userId, timestamp])
  @@index([tenantId, timestamp])
  @@index([timestamp])
  @@index([riskLevel])
  @@index([decision])
  @@index([tenantId], map: "Transaction_tenant_isolation_idx")
}

model ThresholdConfig {
  id Int @id @default(autoincrement())
  tenantId String @unique @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id])
  timezone String @default("America/Argentina/Buenos_Aires")
  defaultCurrency String @default("ARS")

  minAmountEnabled Boolean @default(true)
  minAmount        Float   @default(10000)
  reviewThreshold  Float   @default(60)
  blockThreshold   Float   @default(85)

  updatedBy String   @default("seed")
  updatedAt DateTime @updatedAt
  @@index([tenantId], map: "ThresholdConfig_tenant_isolation_idx")
}

model ThresholdConfigHistory {
  tenantId String @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id])

  id Int @id @default(autoincrement())

  minAmountEnabled Boolean
  minAmount        Float
  reviewThreshold  Float
  blockThreshold   Float

  changedBy String
  changedAt DateTime @default(now())
  @@index([tenantId], map: "ThresholdConfigHistory_tenant_isolation_idx")
}

// Append-only review history. The automatic decision remains unchanged.
model TransactionReview {
  tenantId String @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id])

  id Int @id @default(autoincrement())
  transactionId String
  transaction Transaction @relation(fields: [transactionId, tenantId], references: [id, tenantId], onDelete: NoAction, onUpdate: Cascade, map: "TransactionReview_transaction_tenant_fkey")
  outcome String // fraud | legitimate | pending
  analyst String
  comment String
  createdAt DateTime @default(now())

  @@index([transactionId, createdAt])
  @@index([tenantId], map: "TransactionReview_tenant_isolation_idx")
}

model FraudCase {
  tenantId String @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id])

  id            String      @id @default(uuid())
  transactionId String      @unique
  transaction   Transaction @relation(fields: [transactionId, tenantId], references: [id, tenantId], onDelete: NoAction, onUpdate: Cascade, map: "FraudCase_transaction_tenant_fkey")
  status        String      @default("open") // open | investigating | resolved | closed
  priority      String      @default("normal") // low | normal | high | critical
  reason        String
  assignedTo    String?
  resolution    String?
  createdBy     String
  resolvedBy    String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  resolvedAt    DateTime?

  @@index([status, priority])
  @@index([createdAt])
  @@unique([transactionId, tenantId])
  @@index([tenantId], map: "FraudCase_tenant_isolation_idx")
}

model AuditLog {
  tenantId String @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id])

  id           String   @id @default(uuid())
  actor        String
  actorRole    String
  action       String
  resourceType String
  resourceId   String?
  outcome      String
  metadata     String   // JSON
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())

  transactionId String?
  transaction Transaction? @relation(fields: [transactionId, tenantId], references: [id, tenantId], onDelete: NoAction, onUpdate: Cascade, map: "AuditLog_transaction_tenant_fkey")
  @@index([resourceType, resourceId, createdAt])
  @@index([actor, createdAt])
  @@index([tenantId], map: "AuditLog_tenant_isolation_idx")
}

model Tenant {
  id String @id @default(uuid()) @db.Uuid
  name String
  slug String @unique
  status String @default("active")
  plan String @default("free")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships TenantMembership[]
  roles Role[]
  transactions Transaction[]
  settings ThresholdConfig?
  settingsHistory ThresholdConfigHistory[]
  reviews TransactionReview[]
  cases FraudCase[]
  auditLogs AuditLog[]
  apiClients ApiClient[]
  alerts Alert[]
  model TenantModel?
}

model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  name String
  passwordHash String
  status String @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships TenantMembership[]
  platformRoles PlatformUserRole[]
  sessions Session[]
}

model TenantMembership {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  userId String @db.Uuid
  roleId String @db.Uuid
  status String @default("active")
  tenant Tenant @relation(fields: [tenantId], references: [id])
  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([tenantId, userId])
  @@index([userId])
}

model Role {
  id String @id @default(uuid()) @db.Uuid
  tenantId String? @db.Uuid
  tenant Tenant? @relation(fields: [tenantId], references: [id])
  name String
  type String @default("system")
  memberships TenantMembership[]
  permissions RolePermission[]
  @@unique([tenantId, name])
}

model Permission {
  id String @id @default(uuid()) @db.Uuid
  code String @unique
  description String
  roles RolePermission[]
}

model RolePermission {
  roleId String @db.Uuid
  permissionId String @db.Uuid
  role Role @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])
  @@id([roleId, permissionId])
}

model PlatformUserRole {
  userId String @db.Uuid
  role String
  user User @relation(fields: [userId], references: [id])
  @@id([userId, role])
}

model Session {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  user User @relation(fields: [userId], references: [id])
  tokenHash String @unique
  refreshHash String @unique
  tenantId String? @db.Uuid
  expiresAt DateTime
  refreshExpiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId])
}

model ApiClient {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id])
  name String
  credential ApiCredential?
  permissions String[]
  status String @default("active")
  lastUsedAt DateTime?
  createdAt DateTime @default(now())
  @@index([tenantId], map: "ApiClient_tenant_isolation_idx")
}

// Credential lookup contains no business data and is independent of tenant-scoped API clients.
model ApiCredential {
  id String @id @default(uuid()) @db.Uuid
  clientId String @unique @db.Uuid
  tenantId String @db.Uuid
  secretHash String @unique
  client ApiClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model Alert {
  id String @id @default(uuid()) @db.Uuid
  tenantId String @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id])
  transactionId String @unique
  transaction Transaction @relation(fields: [transactionId, tenantId], references: [id, tenantId], onDelete: NoAction, onUpdate: Cascade, map: "Alert_transaction_tenant_fkey")
  severity String
  status String @default("open")
  assignedTo String?
  createdAt DateTime @default(now())
  resolvedAt DateTime?
  @@index([tenantId, status, createdAt])
}

model MlModel {
  id String @id @default(uuid()) @db.Uuid
  name String
  version String @unique
  status String @default("active")
  modelType String
  artifactPath String?
  metrics Json @default("{}")
  createdAt DateTime @default(now())
  tenants TenantModel[]
}

model TenantModel {
  tenantId String @id @db.Uuid
  tenant Tenant @relation(fields: [tenantId], references: [id])
  modelId String @db.Uuid
  model MlModel @relation(fields: [modelId], references: [id])
  enabled Boolean @default(true)
  configuration Json @default("{}")
  createdAt DateTime @default(now())
}

model AuthEvent {
  id String @id @default(uuid()) @db.Uuid
  userId String? @db.Uuid
  action String
  createdAt DateTime @default(now())
  @@index([createdAt])
}

// Historial global (append-only) de altas, cambios y bajas de organizaciones y
// usuarios, y de las consultas/exportaciones del reporte de organizaciones.
model PlatformAuditLog {
  id String @id @default(uuid()) @db.Uuid
  actor String
  actorRole String
  action String
  resourceType String
  resourceId String?
  tenantId String? @db.Uuid
  metadata Json @default("{}")
  createdAt DateTime @default(now())
  @@index([createdAt])
  @@index([tenantId, createdAt])
}

// QR login challenges live in the database because on Vercel the challenge, its
// authorization and the status polling may reach different function instances.
model QrChallenge {
  id String @id // sha256 of the challenge_id; the plain value only travels in the QR code
  status String @default("PENDING")
  userId String? @db.Uuid
  tenantId String? @db.Uuid
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([expiresAt])
}
