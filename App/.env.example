# Runtime role: NOSUPERUSER NOBYPASSRLS, not the migration owner.
# Supabase on Vercel: transaction pooler (6543) as fraudlens_app.<project-ref>, with pgbouncer=true.
DATABASE_URL="postgresql://fraudlens_app:PASSWORD@HOST:6543/postgres?sslmode=require&pgbouncer=true&connection_limit=3"
# Schema owner, used only by Prisma migrations (session pooler or direct connection).
DIRECT_URL="postgresql://OWNER:PASSWORD@HOST:5432/postgres?sslmode=require"
# Only when another web origin must call the API; the bundled web uses the same origin.
# CORS_ORIGIN=https://otro-sitio.example
# Only to point the web at a different API; empty means same origin (/api/v1).
# NEXT_PUBLIC_API_URL=
# Used only by npm run seed; never configure these in Vercel.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
SEED_DEMO_DATA=false
# Optional global fallback. Per-tenant assignment is available through /settings/model.
# FRAUD_MODEL_PATH=./models/fraud-model.json
ML_ARTIFACT_ROOT=./models
