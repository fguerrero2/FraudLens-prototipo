{
  "name": "fraudlens-app",
  "private": true,
  "version": "0.2.0",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "build": "prisma generate && next build",
    "vercel-build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "tsx prisma/seed.ts",
    "openapi": "TS_NODE_PROJECT=tsconfig.test.json ts-node scripts/export-openapi.ts",
    "test": "TS_NODE_PROJECT=tsconfig.test.json node --test -r ts-node/register test/*.test.ts && node --test test/i18n.test.mjs",
    "test:docker": "node test/docker-integration.cjs",
    "evaluate": "TS_NODE_PROJECT=tsconfig.test.json ts-node evaluation/run.ts",
    "prepare:datasets": "TS_NODE_PROJECT=tsconfig.test.json ts-node evaluation/prepare-datasets.ts",
    "split:open-datasets": "TS_NODE_PROJECT=tsconfig.test.json ts-node evaluation/split-open-datasets.ts",
    "evaluate:datasets": "TS_NODE_PROJECT=tsconfig.test.json ts-node evaluation/run-datasets.ts",
    "model:promote": "TS_NODE_PROJECT=tsconfig.test.json ts-node evaluation/promote-model.ts",
    "evaluation:export": "TS_NODE_PROJECT=tsconfig.test.json ts-node evaluation/export-reviews.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "class-validator-jsonschema": "5.2.0",
    "exceljs": "^4.4.0",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0",
    "lucide-react": "1.34.0",
    "next": "16.4.2",
    "prisma": "^6.19.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "reflect-metadata": "0.2.2",
    "swagger-ui-dist": "5.33.1",
    "tsx": "^4.20.6"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "26.3.0",
    "@types/react": "^19.2.0",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  }
}
