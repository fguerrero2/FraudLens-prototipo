{
  "name": "fraudlens-backend",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "postinstall": "prisma generate",
    "build": "nest build",
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "seed": "node dist/prisma/seed.js",
    "test": "node --test -r ts-node/register test/*.test.ts",
    "evaluate": "ts-node evaluation/run.ts",
    "prepare:datasets": "ts-node evaluation/prepare-datasets.ts",
    "split:open-datasets": "ts-node evaluation/split-open-datasets.ts",
    "evaluate:datasets": "ts-node evaluation/run-datasets.ts",
    "model:promote": "ts-node evaluation/promote-model.ts",
    "evaluation:export": "ts-node evaluation/export-reviews.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/client": "^6.19.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "exceljs": "^4.4.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@nestjs/cli": "11.0.24",
    "@types/express": "5.0.6",
    "@types/node": "26.3.0",
    "prisma": "^6.19.3",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "prisma@6.19.3": true
  },
  "overrides": {
    "@nestjs/swagger": {
      "js-yaml": "^5.4.3"
    }
  }
}
