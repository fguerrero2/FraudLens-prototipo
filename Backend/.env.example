# App role: NOSUPERUSER NOBYPASSRLS, and not the migration owner.
DATABASE_URL="postgresql://fraudlens_app:PASSWORD@HOST/fraudlens?sslmode=require&connection_limit=3"
# Schema owner, used only by Prisma migrations (Neon unpooled URL).
DIRECT_URL="postgresql://OWNER:PASSWORD@HOST/fraudlens?sslmode=require"
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Used only by npm run seed; do not configure these in web/mobile builds.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=
SEED_DEMO_DATA=false
# Optional global fallback. Per-tenant assignment is available through /settings/model.
# FRAUD_MODEL_PATH=./models/fraud-model.json
ML_ARTIFACT_ROOT=./models
