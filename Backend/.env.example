# Render Postgres. A diferencia de Supabase, no hay pooler/conexion directa
# separados: DATABASE_URL y DIRECT_URL usan la misma connection string
# (Render -> el Postgres -> Connect -> Internal/External Database URL).
DATABASE_URL="postgresql://fraudlens:PASSWORD@dpg-xxxxxxxx-a.oregon-postgres.render.com/fraudlens"
DIRECT_URL="postgresql://fraudlens:PASSWORD@dpg-xxxxxxxx-a.oregon-postgres.render.com/fraudlens"
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Placeholder API keys (MVP). Reemplazar por autenticacion real mas adelante.
CLIENT_API_KEY=client_dev_key_change_me
ANALYST_API_KEY=analyst_dev_key_change_me
ADMIN_API_KEY=admin_dev_key_change_me
