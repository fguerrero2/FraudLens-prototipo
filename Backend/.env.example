# Supabase Postgres. DATABASE_URL usa el pooler (puerto 6543, pgbouncer=true)
# para runtime; DIRECT_URL usa la conexion directa (puerto 5432) que Prisma
# necesita para correr migraciones. Ambas se copian desde
# Supabase -> Project Settings -> Database -> Connection string.
DATABASE_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres"
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Placeholder API keys (MVP). Reemplazar por autenticacion real mas adelante.
CLIENT_API_KEY=client_dev_key_change_me
ANALYST_API_KEY=analyst_dev_key_change_me
ADMIN_API_KEY=admin_dev_key_change_me
